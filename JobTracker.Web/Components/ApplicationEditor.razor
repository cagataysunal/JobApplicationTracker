@inject ApiClient Api

<EditForm Model="form" OnValidSubmit="SaveAsync" class="card form">
    <DataAnnotationsValidator />
    <h2>@(Existing is null ? "New application" : "Edit application")</h2>

    <div class="grid">
        <label>
            Company
            <InputSelect @bind-Value="form.CompanyId">
                <option value="">Select…</option>
                @foreach (var company in Companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => form.CompanyId" />
        </label>

        <label>
            Position
            <InputText @bind-Value="form.Position" />
            <ValidationMessage For="() => form.Position" />
        </label>

        <label>
            Work mode
            <InputSelect @bind-Value="form.WorkMode">
                @foreach (var mode in Enum.GetValues<WorkMode>())
                {
                    <option value="@mode">@mode</option>
                }
            </InputSelect>
        </label>

        <label>
            Location
            <InputText @bind-Value="form.Location" />
        </label>

        <label>
            Status
            <InputSelect @bind-Value="form.Status">
                @foreach (var status in Enum.GetValues<ApplicationStatus>())
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </label>

        <label>
            Applied on
            <InputDate @bind-Value="form.AppliedOn" />
        </label>

        <label class="wide">
            Posting URL
            <InputText @bind-Value="form.PostingUrl" />
            <ValidationMessage For="() => form.PostingUrl" />
        </label>

        <fieldset class="wide salary">
            <legend>Salary (optional)</legend>
            <InputNumber @bind-Value="form.SalaryMin" placeholder="Min" />
            <InputNumber @bind-Value="form.SalaryMax" placeholder="Max" />
            <InputText @bind-Value="form.Currency" maxlength="3" class="currency" />
            <InputSelect @bind-Value="form.SalaryPeriod">
                @foreach (var period in Enum.GetValues<SalaryPeriod>())
                {
                    <option value="@period">@period</option>
                }
            </InputSelect>
        </fieldset>

        <label class="wide">
            Notes
            <InputTextArea @bind-Value="form.Notes" rows="3" />
        </label>
    </div>

    <ErrorBanner Message="@error" />

    <div class="actions">
        <button type="submit" class="primary" disabled="@saving">Save</button>
        <button type="button" @onclick="OnCancel">Cancel</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public List<Company> Companies { get; set; } = [];
    [Parameter] public JobApplication? Existing { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private JobApplicationForm form = new();
    private string? error;
    private bool saving;

    protected override void OnParametersSet() =>
        form = Existing is null ? new JobApplicationForm() : JobApplicationForm.From(Existing);

    private async Task SaveAsync()
    {
        saving = true;
        var request = form.ToRequest();
        var result = Existing is null
            ? await Api.CreateApplicationAsync(request)
            : await Api.UpdateApplicationAsync(Existing.Id, request);
        saving = false;

        if (result.Ok)
            await OnSaved.InvokeAsync();
        else
            error = result.Error;
    }
}
